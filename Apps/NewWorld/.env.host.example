# Copy this file to .env.host. Never commit .env.host or real credentials.
# Use a private VPN address for the central PostgreSQL server (Tailscale/WireGuard).
NEW_WORLD_CONNECTION_STRING=Host=100.64.0.10;Port=5432;Database=newworld;Username=newworld_host;Password=REPLACE_WITH_A_LONG_RANDOM_SECRET;SSL Mode=Require

# Must be unique for every independently hosted match-server process.
NEW_WORLD_INSTANCE_ID=host-change-this-id

# Keep the .NET container bound to localhost; expose it through a TLS reverse proxy.
NEW_WORLD_BIND_ADDRESS=127.0.0.1
NEW_WORLD_PORT=5000

# Exact origin of the browser client. Separate multiple origins with semicolons.
NEW_WORLD_ALLOWED_ORIGINS=https://belfegor442.github.io
